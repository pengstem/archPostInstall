# ~/.config/neomutt/colors.muttrc
# Gruvbox Dark (medium) truecolor theme for NeoMutt

##### 基础整体风格 #####

color normal        #ebdbb2        #282828
color tilde         #504945        #282828

color message       #b8bb26        #282828
color error         #fb4934        #282828
color prompt        #d3869b        #282828

color status        #282828        #d79921
color indicator     #282828        #83a598
color tree          #83a598        #282828
color search        #282828        #fabd2f
color markers       #fe8019        #282828

##### Header / Body 细节 #####

color hdrdefault    #ebdbb2        #282828

color header        #fabd2f        #282828   "^Subject:"
color header        #83a598        #282828   "^From:"
color header        #83a598        #282828   "^To:"
color header        #83a598        #282828   "^Cc:"
color header        #83a598        #282828   "^Reply-To:"

color quoted        #b8bb26        #282828   # level 1
color quoted2       #8ec07c        #282828   # level 2
color quoted3       #83a598        #282828   # level 3
color quoted4       #d3869b        #282828   # level 4

color signature     #928374        #282828
color attachment    #8ec07c        #282828

##### Index 列表状态 #####

color index         #b8bb26        #282828   "~N"
color index         #fabd2f        #282828   "~O"
color index         #d3869b        #282828   "~Q"
color index         #a89984        #282828   "~R"
color index         #fb4934        #282828   "~D"
color index         #fe8019        #282828   "~F"
color index         #83a598        #282828   "~T"

##### Sidebar 颜色 #####

color sidebar_background   #ebdbb2    #1d2021
color sidebar_divider      #665c54    #1d2021

color sidebar_indicator    #282828    #fabd2f
color sidebar_highlight    #282828    #83a598

color sidebar_new          #b8bb26    #1d2021
color sidebar_unread       #fabd2f    #1d2021
color sidebar_flagged      #fe8019    #1d2021
color sidebar_spool_file   #83a598    #1d2021
color sidebar_ordinary     #ebdbb2    #1d2021
