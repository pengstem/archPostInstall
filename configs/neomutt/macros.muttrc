# ~/.config/neomutt/macros.muttrc

# 避免 "Binding 'g*' will alias 'g'" 的警告
bind index g noop
bind pager g noop

#### Vim 风格导航 ####
# Index 里补齐 gg/G
bind index gg first-entry
bind index G  last-entry

# Pager 里用 j/k 按行滚动
bind pager j next-line
bind pager k previous-line

# 用 g 系前缀做 Sidebar 导航（不干扰你现有的 g{ i/a/s/d/t/* } 跳转）
bind index,pager gj sidebar-next
bind index,pager gk sidebar-prev
bind index,pager go sidebar-open

#### Vim 激进键位（覆盖部分默认键） ####
# Index: h/l 翻页，Ctrl-u/d 半页
bind index h   previous-page
bind index l   next-page
bind index \Cu half-up
bind index \Cd half-down

# Index: 线程折叠（toggle）
bind index za collapse-thread
bind index zA collapse-all

# Pager: h/l 翻页，Ctrl-u/d 半页
bind pager h   previous-page
bind pager l   next-page
bind pager \Cu half-up
bind pager \Cd half-down

# 搜索：N = 反向搜索（vim 习惯）
bind index N search-opposite
bind pager N search-opposite

#### Sidebar 键位 ####
bind index,pager \Cp  sidebar-prev
bind index,pager \Cn  sidebar-next
bind index,pager \Co  sidebar-open
bind index,pager B    sidebar-toggle-visible
bind index,pager <F3> sidebar-page-up
bind index,pager <F4> sidebar-page-down
bind index,pager <F5> sidebar-prev-new
bind index,pager <F6> sidebar-next-new

#### 类 Gmail 跳转 ####
macro index gi "<change-folder>+INBOX<enter>"              "Go to Inbox"
macro index ga "<change-folder>+[Gmail]/All Mail<enter>"   "Go to All Mail"
macro index gs "<change-folder>+[Gmail]/Sent Mail<enter>"  "Go to Sent"
macro index gd "<change-folder>+[Gmail]/Drafts<enter>"     "Go to Drafts"
macro index gt "<change-folder>+[Gmail]/Trash<enter>"      "Go to Trash"
macro index g* "<change-folder>+[Gmail]/Starred<enter>"    "Go to Starred"

#### 回复 / 标记 / 过滤 ####

# R = reply-all，对应 NeoMutt 函数名是 group-reply
bind index R group-reply

# ,a：切换 flagged 然后下移一行
macro index ,a "<toggle-flag><next-entry>" "Toggle flagged and move down"

# ,u：只看未读
macro index ,u "<limit>~N<enter>" "Limit to unread"
# ,U：清空 limit
macro index ,U "<limit><enter>"   "Clear limit"

# ,s：保存当前邮件到 Starred
macro index ,s "<save-message>+[Gmail]/Starred<enter>" "Save to Starred"
