# Load modular Zsh config files from ~/.config/zsh/rc.d in lexical order.
# This file intentionally stays small to keep bootstrap and debugging simple.

if [[ $- != *i* ]]; then
    return
fi

ZSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/rc.d"

for zsh_config in "$ZSH_CONFIG_DIR"/*.zsh(N); do
    source "$zsh_config"
done

unset ZSH_CONFIG_DIR zsh_config

if [[ -s "$HOME/.bun/_bun" ]] && (( ${+functions[compdef]} )); then
    source "$HOME/.bun/_bun"
fi

# bun completions
[ -s "/home/nastem/.bun/_bun" ] && source "/home/nastem/.bun/_bun"
export PATH="$HOME/x-tools/loongarch64-unknown-linux-musl/bin:$PATH"


# Added by Antigravity CLI installer
export PATH="/home/nastem/.local/bin:$PATH"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
